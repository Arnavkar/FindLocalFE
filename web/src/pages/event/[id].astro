---
// /event/<uuid>: 404 unknown, 410 + noindex when the date has passed (city tz)
// or the venue delisted it (is_deleted=1; friendly notice still rendered),
// otherwise 200 with Event + BreadcrumbList JSON-LD. Uppercase uuids 301 in the middleware.
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import ReportButton from '../../components/ReportButton.astro';
import SaveButton from '../../components/SaveButton.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getDb, getEvent, listSeriesDates, listUpcomingEventsForVenue } from '../../lib/db.js';
import { categoryLabel, cleanText, eventImage, eventLink, longDate, priceLabel, shortDate, truncate } from '../../lib/format.js';
import { googleCalendarUrl } from '../../lib/ics.js';
import { breadcrumbJsonLd, eventJsonLd } from '../../lib/jsonld.js';
import { DEFAULT_TZ, SITE, formatEventDate, formatTime, getCity, isUuid, todayIn } from '@findlocal/shared';

const id = Astro.params.id ?? '';
const event = isUuid(id) ? await getEvent(getDb(), id) : null;
if (!event) {
  Astro.response.status = 404;
}
const city = event ? getCity(event.city) : undefined;
const tz = city?.tz ?? DEFAULT_TZ;
const today = todayIn(tz);
const isPast = !!event && event.event_date < today;
const isDelisted = !!event && !isPast && event.is_deleted === 1;
if (isPast || isDelisted) Astro.response.status = 410;

const description = event ? cleanText(event.description) : '';
const metaDescription = event
  ? truncate(description || `${event.title} at ${event.venue_name} in ${event.city} on ${shortDate(event.event_date, tz)}.`, 160)
  : '';
const image = event ? eventImage(event) : null;
const link = event ? eventLink(event) : null;
const price = event ? priceLabel(event) : '';
const [seriesDates, more] = event && !isPast
  ? await Promise.all([
      event.series_count > 1 ? listSeriesDates(getDb(), event.venue_id, event.title) : Promise.resolve([] as string[]),
      listUpcomingEventsForVenue(getDb(), event.venue_id, 7),
    ])
  : [[], []];
const otherDates = seriesDates.filter((d) => d !== event?.event_date);
const moreAtVenue = more.filter((e) => e.id !== event?.id).slice(0, 6);
const crumbs = event
  ? [
      { name: 'Home', path: '/' },
      ...(city ? [{ name: `Events in ${city.name}`, path: `/city/${city.slug}` }] : []),
      { name: event.title, path: `/event/${event.id}` },
    ]
  : [];
const live = !!event && !isPast && !isDelisted;
const jsonLd = event && live && city ? [eventJsonLd(event, city, description, image), breadcrumbJsonLd(crumbs)] : null;
const canonicalPath = event ? `/event/${event.id}` : Astro.url.pathname;
const pageTitle = event ? `${event.title} - ${shortDate(event.event_date, tz)} at ${event.venue_name} | Find Local Events` : 'Event not available';
const jsonAlternate = event ? `${SITE}/api/events/${event.id}` : undefined;
const mapsHref = event?.venue_address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${event.venue_name}, ${event.venue_address}`)}` : null;
---
{!event ? (
  <Layout title="Event not available" description="This event has ended or been removed. Browse upcoming local events on Find Local." canonicalPath={canonicalPath} noindex>
    <h1>Event not found</h1>
    <p class="empty">No event with this id. <a href="/">Browse upcoming events</a>.</p>
  </Layout>
) : (
  <Layout
    title={pageTitle}
    description={metaDescription}
    canonicalPath={canonicalPath}
    noindex={isPast || isDelisted}
    ogType="article"
    ogImage={image}
    brandInTitle={false}
    jsonAlternate={jsonAlternate}
  >
    {jsonLd && <JsonLd data={jsonLd} slot="head" />}
    <article class="event">
      <Breadcrumbs crumbs={crumbs} />
      {city && <BackLink href={`/city/${city.slug}`} label={`Back to events in ${city.name}`} />}
      <div class="hero">
        {image ? (
          <img src={image} alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
        ) : (
          <div class="placeholder" aria-hidden="true">{categoryLabel(event.category) || 'Event'}</div>
        )}
        {price && <span class="pill price">{price}</span>}
        {event.series_count > 1 && <span class="pill recurring">↻ Recurring</span>}
      </div>

      {isPast && <p class="notice warn"><strong>This event has already passed.</strong> Looking for something current? <a href={`/venue/${event.venue_id}`}>See what's next at {event.venue_name}</a>.</p>}
      {isDelisted && <p class="notice warn"><strong>This event is no longer listed by the venue.</strong> It may have been cancelled or moved — check with <a href={`/venue/${event.venue_id}`}>{event.venue_name}</a> before you go.</p>}
      {live && /cancel/i.test(event.status ?? '') && <p class="notice warn"><strong>Cancelled</strong> according to the source listing.</p>}

      <h1>{event.title}</h1>
      <ul class="meta">
        <li><Icon name="calendar" size={18} /><span>{longDate(event.event_date, tz)}{formatTime(event.start_time) ? ` · ${formatTime(event.start_time)}` : ''}{event.end_time && formatTime(event.end_time) ? ` – ${formatTime(event.end_time)}` : ''}</span></li>
        {otherDates.length > 0 && (
          <li><span class="glyph" aria-hidden="true">↻</span><span>Recurring · {seriesDates.length} upcoming dates (also {otherDates.slice(0, 3).map((d) => formatEventDate(d, tz)).join(', ')}{otherDates.length > 3 ? ` +${otherDates.length - 3} more` : ''})</span></li>
        )}
        <li><Icon name="location" size={18} /><span><a href={`/venue/${event.venue_id}`}>{event.venue_name}</a>{event.venue_address ? ` · ${event.venue_address}` : ''}{event.region ? ` · ${event.region}` : ''}</span></li>
        {event.category && <li><span class="glyph" aria-hidden="true">#</span><span><a rel="nofollow" href={city ? `/city/${city.slug}?cat=${event.category}` : '#'}>{categoryLabel(event.category)}</a>{event.event_type.length ? ` · ${event.event_type.slice(0, 4).join(', ')}` : ''}</span></li>}
      </ul>

      <div class="actions">
        <ShareButton title={event.title} url={`${SITE}/event/${event.id}`} />
        {!isPast && (
          <details class="calendar">
            <summary class="btn ghost"><Icon name="calendar" size={18} /> Calendar</summary>
            <div class="menu">
              <a href={googleCalendarUrl(event, tz)} target="_blank" rel="noopener nofollow">Google Calendar</a>
              <a href={`/event/${event.id}/calendar.ics`} download={`${event.title.replace(/[^a-z0-9]+/gi, '_')}.ics`}>Apple / Outlook (.ics)</a>
            </div>
          </details>
        )}
        <SaveButton eventId={event.id} />
        {!isPast && <ReportButton eventId={event.id} />}
      </div>
      {live && link && <a class="btn orange cta" href={link.href} rel="noopener nofollow" target="_blank">{link.label}</a>}

      {description && (
        <section class="panel">
          <h2>About this event</h2>
          <p class="desc">{description}</p>
        </section>
      )}
      <section class="panel">
        <h2>Venue</h2>
        <p><a class="venue-name" href={`/venue/${event.venue_id}`}>{event.venue_name}</a></p>
        {event.venue_address && <p class="muted">{mapsHref ? <a href={mapsHref} target="_blank" rel="noopener">{event.venue_address}</a> : event.venue_address}</p>}
        {event.venue_url && <p><a href={event.venue_url} rel="noopener nofollow" target="_blank">Venue website</a></p>}
        <p class="venue-links"><a href={`/venue/${event.venue_id}`}>All events at {event.venue_name}</a>{city && <> · <a href="/venues">All venues in {city.name}</a></>}</p>
      </section>

      {moreAtVenue.length > 0 && (
        <section class="more">
          <h2>More at {event.venue_name}</h2>
          <div class="grid">{moreAtVenue.map((e) => <EventCard event={e} tz={tz} />)}</div>
          <p class="more-link"><a href={`/venue/${event.venue_id}`}>See everything coming up at {event.venue_name} →</a></p>
        </section>
      )}
      <p class="source faint">Listing sourced from {event.venue_name}{event.detail_page_url || event.root_url ? <> (<a href={event.detail_page_url ?? event.root_url ?? '#'} rel="noopener nofollow" target="_blank">original page</a>)</> : null}. Details can change — confirm with the venue.</p>
    </article>
  </Layout>
)}

<style>
  .event { max-width: 820px; }
  .hero { position: relative; aspect-ratio: 16 / 9; max-height: 400px; border-radius: var(--radius); overflow: hidden; background: rgb(var(--surface-sunken)); margin-bottom: 1rem; }
  .hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero .placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #006565 0%, #4DA399 60%, #80D8CA 100%); color: #fff; font-family: var(--font-head); font-weight: 700; font-size: 1.6rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .hero .pill { position: absolute; top: 10px; padding: 0.25rem 0.8rem; border-radius: 999px; background: rgb(var(--bg) / 0.92); font-size: 0.8rem; font-weight: 700; }
  .hero .price { right: 10px; }
  .hero .recurring { left: 10px; }
  .notice { padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); border: 1px solid rgb(var(--warning)); background: rgb(var(--warning) / 0.12); }
  h1 { margin: 0.4rem 0 0.8rem; }
  .meta { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .meta li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .meta svg, .glyph { color: rgb(var(--teal)); flex-shrink: 0; margin-top: 0.15rem; width: 18px; text-align: center; font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 0.9rem; }
  .calendar { position: relative; }
  .calendar summary { list-style: none; cursor: pointer; }
  .calendar summary::-webkit-details-marker { display: none; }
  .calendar .menu { position: absolute; top: calc(100% + 4px); left: 0; z-index: 20; min-width: 200px; background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); border-radius: var(--radius-sm); box-shadow: var(--shadow-md); display: flex; flex-direction: column; }
  .calendar .menu a { padding: 0.55rem 0.9rem; color: rgb(var(--text)); font-weight: 600; font-size: 0.9rem; }
  .calendar .menu a:hover { background: rgb(var(--teal) / 0.08); text-decoration: none; }
  .cta { margin: 0 0 1.25rem; min-width: 200px; }
  .panel { background: rgb(var(--surface-sunken)); border-radius: var(--radius); padding: 1rem 1.1rem; margin: 0 0 1rem; }
  .panel h2 { font-size: 1.05rem; margin: 0 0 0.5rem; }
  .panel p:last-child { margin-bottom: 0; }
  .desc { white-space: pre-line; color: rgb(var(--text-2)); line-height: 1.65; }
  .venue-name { font-weight: 700; font-size: 1.05rem; }
  .more { margin-top: 1.5rem; }
  .more h2 { margin-bottom: 0.8rem; }
  .more-link { margin: 1rem 0 0; font-weight: 600; }
  .venue-links { font-size: 0.92rem; }
  .source { font-size: 0.8rem; margin-top: 1.5rem; }
</style>
