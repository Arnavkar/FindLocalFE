---
// /platform — the pitch for venues, organisers and local sites who want live
// local events without maintaining a calendar themselves. Non-developer
// audience; the technical reference lives under /developers (index, api, mcp,
// widgets) and web/src/lib/embed.ts (widget presets + attributes).
import Layout from '../layouts/Layout.astro';
import { CITIES } from '@findlocal/shared';
export const prerender = true;
const MCP_URL = 'https://mcp.findlocal.community/mcp';
const cityCount = CITIES.length;

const benefits = [
  ['Nothing to maintain', 'No calendar plugin to update, no CMS component to babysit. Paste it once and it keeps working.'],
  ['Always current', 'Venue calendars are re-scraped daily. Events that disappear from the source drop out of the feed too — no stale listings.'],
  ['One feed, every venue in town', 'Not just yours — a shared local feed is useful to visitors even when they came for one venue.'],
  ['Free to start', 'The widget and JSON API are free with no signup. The AI assistant connector has a free demo key.'],
] as const;

const products = [
  {
    name: 'Widgets',
    blurb: 'Embed one script tag. Renders a list, calendar and map of live events, follows light/dark theme, and resizes itself.',
    label: 'any HTML page',
    code: '<script src="https://findlocal.community/widget.js" data-widget="literary-new-england"></script>',
    href: '/developers/widgets',
    cta: 'Widget builder & reference',
  },
  {
    name: 'JSON API',
    blurb: 'A plain HTTPS GET with the same filters as the site\'s URLs. No key, no signup, CORS open.',
    label: 'curl',
    code: "curl 'https://findlocal.community/api/events?city=boston&when=weekend'",
    href: '/developers/api',
    cta: 'API reference',
  },
  {
    name: 'AI assistants (MCP)',
    blurb: 'Let Claude, Cursor or a ChatGPT-style client answer "what\'s on near me?" from live, sourced data.',
    label: 'MCP endpoint',
    code: MCP_URL,
    href: '/developers/mcp',
    cta: 'MCP reference',
  },
] as const;

const steps = [
  ['Verified venues', 'A vetted list of real venues — addresses, calendars and coordinates.'],
  ['Continuous ingestion', 'Venue calendars, ticketing feeds and recurring-event rules, pulled in daily.'],
  ['Normalize & fill gaps', 'Clean fields, resolved venues, structured dates, categories, prices and links.'],
  ['Serve to your product', 'A widget, the JSON API, or an MCP tool for AI assistants — same data, three doors.'],
] as const;

const audiences = [
  ['For venues', 'Show your own events without maintaining a calendar — the widget updates itself whenever your listings change.'],
  ['For newsletters & local sites', 'Drop a widget or pull the API into your roundup; one feed covers every venue in town, not just the ones you track by hand.'],
  ['For app builders', 'Query the JSON API or connect the MCP server so your app or agent always has fresh, sourced local event data.'],
] as const;

const sample = [
  { tag: 'Literary', title: 'Author talk & signing', where: 'Independent bookstore · Providence' },
  { tag: 'Comedy', title: 'Open mic night', where: 'Comedy club · Brooklyn' },
  { tag: 'Music', title: 'Friday jazz sessions', where: 'Jazz club · Cambridge' },
];
---
<Layout
  title="FindLocal Platform — Widgets, API & AI assistants for local events"
  description={`Put live local events on your site, in your app, or in your AI assistant. Curated data across ${cityCount} US metros — cleaned, structured and updated daily — through an embeddable widget, a free JSON API, or the FindLocal MCP server.`}
  canonicalPath="/platform"
  wide
>
  <section class="hero">
    <div>
      <p class="eyebrow">FindLocal Platform</p>
      <h1>Put live local events on your site, in your app, or in your AI assistant.</h1>
      <p class="lede">Curated local event data — cleaned, structured and kept current — across {cityCount} US metros and thousands of venues, updated daily.</p>
      <div class="cta">
        <a class="btn" href="/developers/widgets">Get the widget</a>
        <a class="btn ghost" href="/developers">Read the docs</a>
      </div>
    </div>
    <div class="collage" aria-hidden="true">
      {sample.map((s, i) => (
        <div class={`poster p${i + 1}`}>
          <span class="tag">{s.tag}</span>
          <div class="title">{s.title}</div>
          <div class="where">{s.where}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <p class="eyebrow">Why FindLocal</p>
    <h2>Built for venues, organisers and local sites.</h2>
    <div class="benefits">
      {benefits.map(([h, p]) => (
        <div class="benefit-card"><h3>{h}</h3><p>{p}</p></div>
      ))}
    </div>
  </section>

  <section id="products" class="sec">
    <p class="eyebrow">Three ways in</p>
    <h2>Pick the door that fits your product.</h2>
    <p class="lede">Same underlying data, whichever you choose — a widget, the API, or an AI assistant.</p>
    <div class="products">
      {products.map((prod) => (
        <div class="product-card">
          <h3>{prod.name}</h3>
          <p>{prod.blurb}</p>
          <div class="codebox">
            <div class="hd"><span>{prod.label}</span><button type="button" class="copy" data-copy-target={`#c-${prod.name.replace(/[^a-z]/gi, '').toLowerCase()}`}>Copy</button></div>
            <pre id={`c-${prod.name.replace(/[^a-z]/gi, '').toLowerCase()}`}>{prod.code}</pre>
          </div>
          <a class="more" href={prod.href}>{prod.cta} →</a>
        </div>
      ))}
    </div>
  </section>

  <section id="how" class="sec">
    <p class="eyebrow">How it works</p>
    <h2>From scattered listings to usable data.</h2>
    <div class="flow">
      {steps.map(([h, p], i) => (
        <div class="flow-card"><div class="n">{i + 1}</div><h3>{h}</h3><p>{p}</p></div>
      ))}
    </div>
    <p class="muted">Want the long version? Read <a href="/blog/how-find-local-finds-events">how Find Local finds events the big platforms miss</a>.</p>
  </section>

  <section class="sec">
    <div class="audience-strip">
      {audiences.map(([h, p]) => (
        <div class="audience"><h3>{h}</h3><p>{p}</p></div>
      ))}
    </div>
  </section>

  <section id="community" class="sec community">
    <div>
      <p class="eyebrow">findlocal.community</p>
      <h2>Explore events near you.</h2>
      <p class="lede">Browse the same curated data on the web — list and map views, filters, venue pages, and a calendar file for every event.</p>
      <a class="btn" href="/">Explore events →</a>
    </div>
    <div class="feed" aria-hidden="true">
      <div class="feed-bar"><span class="chip active">This weekend</span><span class="chip">Music</span><span class="chip">Free</span><span class="chip">Map</span></div>
      {sample.map((s) => <div class="feed-card"><span class="thumb">{s.tag.slice(0, 1)}</span><div><div class="title">{s.title}</div><div class="sub">{s.where}</div></div></div>)}
    </div>
  </section>
</Layout>

<script>
  import { wireCopyButtons } from '../lib/copy.js';
  wireCopyButtons();
</script>

<style>
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; font-weight: 700; color: rgb(var(--orange)); margin: 0 0 0.5rem; }
  .hero { display: grid; gap: 2rem; align-items: center; padding: 1.5rem 0 2.5rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .collage { position: relative; min-height: 320px; }
  .poster { position: absolute; width: 230px; padding: 0.9rem; border-radius: var(--radius); background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); box-shadow: var(--shadow-md); }
  .poster .tag { display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--teal)); background: rgb(var(--teal-50)); padding: 0.15rem 0.5rem; border-radius: 999px; margin-bottom: 0.4rem; }
  .poster .title { font-family: var(--font-head); font-weight: 700; }
  .poster .where { color: rgb(var(--text-2)); font-size: 0.85rem; }
  .p1 { left: 0; top: 0; transform: rotate(-3deg); } .p2 { right: 0; top: 30px; transform: rotate(2deg); } .p3 { left: 20%; top: 150px; transform: rotate(1deg); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.1fr 1fr; padding: 3rem 0 3.5rem; } .collage { min-height: 260px; } }
  @media (max-width: 899px) { .collage { display: none; } }

  .sec { padding: 2.5rem 0; border-top: 1px solid rgb(var(--border)); scroll-margin-top: 4rem; }
  .sec h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); margin-bottom: 0.6rem; }

  .benefits { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 1.2rem; }
  .benefit-card { border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 1.1rem; background: rgb(var(--surface)); }
  .benefit-card h3 { margin-bottom: 0.4rem; }
  .benefit-card p { margin: 0; color: rgb(var(--text-2)); font-size: 0.92rem; }

  .products { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 1.2rem; }
  .product-card { border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 1.2rem; background: rgb(var(--surface)); display: flex; flex-direction: column; gap: 0.6rem; }
  .product-card p { margin: 0; color: rgb(var(--text-2)); font-size: 0.92rem; }
  .product-card .more { font-weight: 700; margin-top: auto; }
  .codebox { border: 1px solid rgb(var(--border)); border-radius: var(--radius); overflow: hidden; background: rgb(var(--surface-sunken)); }
  .codebox .hd { display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.8rem; font-size: 0.78rem; color: rgb(var(--text-2)); border-bottom: 1px solid rgb(var(--border)); background: rgb(var(--surface)); }
  .codebox pre { margin: 0; padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.82rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre-wrap; word-break: break-word; }
  .copy { font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid rgb(var(--border)); background: rgb(var(--surface)); color: rgb(var(--teal)); cursor: pointer; }

  .flow { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin: 1.2rem 0 1rem; }
  .flow-card { border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 1.1rem; background: rgb(var(--surface)); }
  .flow-card .n { width: 30px; height: 30px; border-radius: 999px; background: rgb(var(--teal)); color: rgb(var(--text-inverse)); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; margin-bottom: 0.6rem; }
  .flow-card p { margin: 0.3rem 0 0; color: rgb(var(--text-2)); font-size: 0.92rem; }

  .audience-strip { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .audience h3 { color: rgb(var(--teal)); margin-bottom: 0.35rem; }
  .audience p { margin: 0; color: rgb(var(--text-2)); font-size: 0.92rem; }

  .community { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 800px) { .community { grid-template-columns: 1fr 1fr; } }
  .feed { border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 0.9rem; background: rgb(var(--surface)); box-shadow: var(--shadow-md); }
  .feed-bar { display: flex; gap: 0.4rem; margin-bottom: 0.8rem; }
  .feed-card { display: flex; gap: 0.7rem; align-items: center; padding: 0.5rem 0; border-top: 1px solid rgb(var(--border)); }
  .feed-card .thumb { width: 44px; height: 44px; border-radius: var(--radius-sm); background: linear-gradient(135deg, #006565, #4DA399); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-family: var(--font-head); }
  .feed-card .title { font-weight: 700; font-family: var(--font-head); }
  .feed-card .sub { color: rgb(var(--text-2)); font-size: 0.85rem; }
</style>
