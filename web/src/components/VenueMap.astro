---
import type { City, VenueRow } from '@findlocal/shared';
import { imageUrl } from '@findlocal/shared';
import LeafletMap, { type MapMarker } from './LeafletMap.astro';
interface Props {
  venues: VenueRow[];
  city: City;
  tall?: boolean;
}
const { venues, city, tall = false } = Astro.props;
const markers: MapMarker[] = venues
  .filter((v) => v.latitude != null && v.longitude != null)
  .map((v) => ({
    lat: v.latitude as number,
    lng: v.longitude as number,
    count: v.upcoming,
    title: v.name,
    href: `/venue/${v.id}`,
    subtitle: [v.address, `${v.upcoming} upcoming`].filter(Boolean).join(' · '),
    image: imageUrl(v.image, { width: 96, height: 96 }) ?? undefined,
  }));
---
<LeafletMap markers={markers} center={{ lat: city.lat, lng: city.lng, zoom: city.zoom }} tall={tall} label={`Map of venues in ${city.name}`} />
