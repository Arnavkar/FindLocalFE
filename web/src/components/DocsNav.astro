---
// Sub-navigation + shared styles for the /developers reference pages.
// Also carries the `.docs` prose rules (tables, code blocks, cards).
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  /** Current page path, e.g. '/developers/api'. */
  current: string;
  title: string;
}
const { current, title } = Astro.props;
const items = [
  { href: '/developers', label: 'Overview' },
  { href: '/developers/api', label: 'JSON API' },
  { href: '/developers/mcp', label: 'MCP server' },
  { href: '/developers/widgets', label: 'Widgets' },
];
const crumbs = current === '/developers'
  ? [{ name: 'Home', path: '/' }, { name: 'Developers', path: '/developers' }]
  : [{ name: 'Home', path: '/' }, { name: 'Developers', path: '/developers' }, { name: title, path: current }];
---
<Breadcrumbs crumbs={crumbs} />
<nav class="docs-nav" aria-label="Developer docs">
  {items.map((i) => <a href={i.href} aria-current={i.href === current ? 'page' : undefined}>{i.label}</a>)}
  <a href="/platform" class="platform">Platform overview →</a>
</nav>

<style is:global>
  .docs-nav { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.4rem; padding-bottom: 0.8rem; border-bottom: 1px solid rgb(var(--border)); }
  .docs-nav a { padding: 0.35rem 0.8rem; border-radius: 999px; font-weight: 600; font-size: 0.88rem; color: rgb(var(--text-2)); border: 1px solid rgb(var(--border)); }
  .docs-nav a:hover { text-decoration: none; border-color: rgb(var(--teal)); color: rgb(var(--teal)); }
  .docs-nav a[aria-current='page'] { background: rgb(var(--teal)); border-color: rgb(var(--teal)); color: rgb(var(--text-inverse)); }
  .docs-nav .platform { margin-left: auto; border-color: transparent; }
  .docs { max-width: 52rem; }
  .docs p, .docs li { color: rgb(var(--text-2)); line-height: 1.65; }
  .docs h2 { margin: 2.2rem 0 0.6rem; scroll-margin-top: 5rem; }
  .docs h3 { margin: 1.5rem 0 0.5rem; scroll-margin-top: 5rem; }
  .docs ul, .docs ol { padding-left: 1.2rem; }
  .docs a { text-decoration: underline; }
  .docs code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.86em; background: rgb(var(--surface-sunken)); padding: 0.1em 0.35em; border-radius: 4px; color: rgb(var(--text)); }
  .docs pre { background: rgb(var(--surface-sunken)); border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.84rem; line-height: 1.5; margin: 0.6rem 0 1rem; position: relative; }
  .docs pre code { background: transparent; padding: 0; font-size: inherit; }
  .docs .table-wrap { overflow-x: auto; margin: 0.6rem 0 1rem; border: 1px solid rgb(var(--border)); border-radius: var(--radius); }
  .docs table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .docs th, .docs td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid rgb(var(--border)); vertical-align: top; }
  .docs th { background: rgb(var(--surface-sunken)); font-weight: 700; font-size: 0.82rem; color: rgb(var(--text-2)); }
  .docs tr:last-child td { border-bottom: 0; }
  .docs td code { white-space: nowrap; }
  .docs .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.9rem; margin: 1rem 0 1.5rem; }
  .docs .card-link { display: block; color: inherit; border: 1px solid rgb(var(--border)); border-radius: var(--radius); padding: 1rem 1.1rem; background: rgb(var(--surface)); text-decoration: none; }
  .docs .card-link:hover { border-color: rgb(var(--teal)); text-decoration: none; }
  .docs .card-link h3 { margin: 0 0 0.3rem; color: rgb(var(--teal)); }
  .docs .card-link p { margin: 0; font-size: 0.92rem; }
  .docs .note { border-left: 3px solid rgb(var(--orange)); background: rgb(var(--orange-50)); padding: 0.7rem 0.9rem; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin: 1rem 0; }
  .docs .note p { margin: 0; color: rgb(var(--text)); }
  .docs .copy-wrap { position: relative; }
  .docs .copy-btn { position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid rgb(var(--border)); background: rgb(var(--surface)); color: rgb(var(--teal)); cursor: pointer; }
  .docs .copy-btn:hover { border-color: rgb(var(--teal)); }
</style>
